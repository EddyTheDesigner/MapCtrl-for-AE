                    control = layer.property("ADBE Effect Parade").addProperty("ADBE Layer Control"); control.name = "Waypoint " + (i + 1); control.property(1).setValue(pins[i].index);
                    expr += "p = [" + points[i][0] + "," + points[i][1] + "];\n";
                    expr += "try { link = effect(\"Waypoint " + (i + 1) + "\")(1); p = thisLayer.fromComp(link.toComp(link.anchorPoint)); } catch (err) {}\n";
