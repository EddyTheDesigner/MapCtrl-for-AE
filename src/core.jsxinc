                identity(textLayer, layer, [r * 1.4, -r * 1.2]); doc = textLayer.property("ADBE Text Properties").property("ADBE Text Document").value;
                doc.fontSize = size * 0.65; doc.applyFill = true; doc.fillColor = [0.96, 0.97, 1]; doc.applyStroke = false; doc.justification = ParagraphJustification.LEFT_JUSTIFY;
                textLayer.property("ADBE Text Properties").property("ADBE Text Document").setValue(doc);
