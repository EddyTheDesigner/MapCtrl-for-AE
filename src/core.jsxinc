        return [numeric(v[0], 0, 0, 1, "Red"), numeric(v[1], 0, 0, 1, "Green"), numeric(v[2], 0, 0, 1, "Blue"), 1];
    }
    function point(v) {
        if (!v || v.length < 2) { fail("Choose a point on the map."); }
        return [numeric(v[0], 0, 0, MapCtrlData.width, "Map X"), numeric(v[1], 0, 0, MapCtrlData.height, "Map Y")];
    }
    function meta(layer) { var s = layer.comment || ""; return s.indexOf(prefix) === 0 ? s.substr(prefix.length).split("|") : null; }
    function tag(layer, kind, id) { layer.comment = prefix + kind + (id ? "|" + id : ""); }
    function uid() { serial += 1; return String(new Date().getTime()) + "-" + serial; }
    function undo(label, fn) { app.beginUndoGroup("MapCtrl - " + label); try { return fn(); } catch (e) { throw new Error(e.toString() + " If partially applied, use Edit > Undo once."); } finally { app.endUndoGroup(); } }
    C.activeComp = function () { return app.project && app.project.activeItem instanceof CompItem ? app.project.activeItem : null; };
    function layers(comp, kind) {
        var a = [], i, m;
        for (i = 1; i <= comp.numLayers; i += 1) { m = meta(comp.layer(i)); if (m && m[0] === kind) { a.push(comp.layer(i)); } }
        return a;
    }
