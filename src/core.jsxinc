/* MapCtrl AE native-layer engine. ES3 ExtendScript. */
var MapCtrlCore = (function () {
    var C = {version: "1.0.0"}, prefix = "mapctrl:v1|", serial = 0;
    function fail(s) { throw new Error(s); }
    function numeric(v, fallback, min, max, label) {
        if (v === undefined) { v = fallback; }
        if (typeof v !== "number" || !isFinite(v) || v < min || v > max) { fail(label + " must be between " + min + " and " + max + "."); }
        return v;
    }
    function rgb(v, fallback) {
