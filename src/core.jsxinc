        p.property("ADBE Vector Stroke Line Join").setValue(2); p.property("ADBE Vector Stroke Line Cap").setValue(2);
    }
    function timing(comp, duration, stagger, count) {
        duration = numeric(duration, 1, comp.frameDuration, 3600, "Duration"); stagger = numeric(stagger, 0, 0, 3600, "Stagger");
        if (comp.time < 0 || comp.time + duration + stagger * Math.max(0, count - 1) > comp.duration + 0.000001) { fail("The animation exceeds the composition. Move the playhead earlier, shorten the timing, or extend the composition."); }
        return {start: comp.time, duration: duration, stagger: stagger};
