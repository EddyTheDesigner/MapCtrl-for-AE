        else { p.setInterpolationTypeAtKey(first, KeyframeInterpolationType.LINEAR, KeyframeInterpolationType.LINEAR); p.setInterpolationTypeAtKey(last, KeyframeInterpolationType.LINEAR, KeyframeInterpolationType.LINEAR); }
    }

    C.createMap = function (options) {
        options = options || {};
        var color = rgb(options.fill, [0.18, 0.24, 0.30]), border = rgb(options.stroke, [0.08, 0.11, 0.15]);
        var width = numeric(options.strokeWidth, 1.2, 0, 50, "Border width"), comp = C.activeComp(), existing = comp ? C.getMap(comp) : null;
        if (existing) {
