    function ease(p, k) {
        var n = 1, a = [], b = [], i;
        if (p.propertyValueType === PropertyValueType.TwoD) { n = 2; }
        if (p.propertyValueType === PropertyValueType.ThreeD) { n = 3; }
        for (i = 0; i < n; i += 1) { a.push(new KeyframeEase(0, 70)); b.push(new KeyframeEase(0, 70)); }
        p.setInterpolationTypeAtKey(k, KeyframeInterpolationType.BEZIER, KeyframeInterpolationType.BEZIER); p.setTemporalEaseAtKey(k, a, b);
