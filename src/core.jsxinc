            if (!app.project) { app.newProject(); }
            if (!comp) { comp = app.project.items.addComp("MapCtrl - United States", 1920, 1080, 1, 10, 30); }
            root = comp.layers.addNull(comp.duration); root.name = "MapCtrl - Map"; tag(root, "root"); root.label = 9;
            identity(root, null, [0, 0]);
            ratio = Math.min(comp.width * 0.88 / MapCtrlData.width, comp.height * 0.88 / MapCtrlData.height);
            tr(root, "ADBE Position").setValue([(comp.width - MapCtrlData.width * ratio) / 2, (comp.height - MapCtrlData.height * ratio) / 2]);
            setVector(root, "ADBE Scale", ratio * 100, ratio * 100, 100);
            for (i = MapCtrlData.states.length - 1; i >= 0; i -= 1) {
                state = MapCtrlData.states[i]; layer = comp.layers.addShape(); layer.name = state.id + " - " + state.name;
                tag(layer, "state", state.id); layer.label = 8; identity(layer, root, state.center); group(layer, "State");
                for (j = 0; j < state.rings.length; j += 1) {
                    vertices = [];
                    for (k = 0; k < state.rings[j].length; k += 1) { vertices.push([state.rings[j][k][0] - state.center[0], state.rings[j][k][1] - state.center[1]]); }
                    path(layer, "State", "Boundary " + (j + 1), geometry(vertices, true));
                }
                fill(layer, "State", color); stroke(layer, "State", border, width);
            }
            root.moveToBeginning(); deselect(comp); root.selected = true; comp.openInViewer(); return {comp: comp, root: root};
        });
    };
    function stateTargets(comp, ids) {
        var result = [], seen = {}, i, layer;
        if (!ids || !ids.length) { fail("Select at least one state."); }
        for (i = 0; i < ids.length; i += 1) {
            if (seen[ids[i]]) { continue; } seen[ids[i]] = true; layer = find(comp, "state", ids[i]);
            if (!layer) { fail("The " + ids[i] + " layer is missing from this map."); } result.push(layer);
        }
        return result;
    }
    C.selectStates = function (ids) { var ctx = context(), a = stateTargets(ctx.comp, ids), i; deselect(ctx.comp); for (i = 0; i < a.length; i += 1) { a[i].selected = true; } return a.length; };
    C.getSelectedStateIds = function () {
        var comp = C.activeComp(), a, result = [], i, m; if (!comp) { return result; } a = comp.selectedLayers;
        for (i = 0; i < a.length; i += 1) { m = meta(a[i]); if (m && m[0] === "state") { result.push(m[1]); } } return result;
    };
    C.setStateFill = function (ids, color, options) {
        options = options || {};
        var ctx = context(), targets = stateTargets(ctx.comp, ids), c = rgb(color, [0.24, 0.78, 0.68]);
        var props = [], starts = [], i, p, g, t;
        if (options.animate) { t = timing(ctx.comp, options.duration, options.stagger, targets.length); }
        for (i = 0; i < targets.length; i += 1) {
            g = contents(targets[i], "State").property("ADBE Vector Graphic - Fill"); p = g ? g.property("ADBE Vector Fill Color") : null;
            editable(targets[i], p); props.push(p); if (options.animate) { starts.push(p.valueAtTime(t.start + i * t.stagger, true)); }
        }
