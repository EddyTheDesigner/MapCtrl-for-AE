        for (i = 0; i < pins.length; i += 1) { p = tr(pins[i], "ADBE Position").value; result.push({id: meta(pins[i])[1], name: pins[i].name, point: [p[0], p[1]]}); } return result;
    };
    function routePath(layer) { return contents(layer, "Route").property("Route path").property("ADBE Vector Shape"); }
    function routeStroke(layer) { return contents(layer, "Route").property("ADBE Vector Graphic - Stroke"); }
    function routeEnd(layer) { var g = contents(layer, "Route").property("ADBE Vector Filter - Trim"); return g ? g.property("ADBE Vector Trim End") : null; }
    C.createRoute = function (waypoints, options) {
        options = options || {};
        var ctx = context(), color = rgb(options.color, [0.35, 0.83, 1]);
        var width = numeric(options.width, 2.5, 0.1, 100, "Route width"), dash = numeric(options.dash, 8, 0.1, 500, "Dash length"), gap = numeric(options.gap, 6, 0.1, 500, "Gap length");
        var flow = numeric(options.flow, 0, -1000, 1000, "Dash flow"), points = [], pins = [], i, pin, p, t, hasDistance = false;
        if (!waypoints || waypoints.length < 2) { fail("Add at least two waypoints to create a route."); }
        if (waypoints.length > 100) { fail("A route can contain up to 100 waypoints."); }
        if (options.animate) { t = timing(ctx.comp, options.duration, 0, 1); }
        for (i = 0; i < waypoints.length; i += 1) {
            pin = null;
            if (waypoints[i].pinId) {
                pin = find(ctx.comp, "pin", waypoints[i].pinId); if (!pin) { fail("A route pin was removed. Refresh the pin list and choose another waypoint."); }
                p = tr(pin, "ADBE Position").value; p = [p[0], p[1]];
            } else { p = point(waypoints[i].point); }
            if (i > 0 && (Math.abs(p[0] - points[i - 1][0]) > 0.001 || Math.abs(p[1] - points[i - 1][1]) > 0.001)) { hasDistance = true; }
            points.push(p); pins.push(pin);
        }
