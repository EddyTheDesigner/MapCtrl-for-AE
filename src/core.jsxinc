            layer.name = "Route - " + waypoints.length + " waypoints"; tag(layer, "route", uid()); layer.label = 10; identity(layer, ctx.root, [0, 0]);
            group(layer, "Route"); path(layer, "Route", "Route path", geometry(points, false)); stroke(layer, "Route", color, width);
            dashes = routeStroke(layer).property("ADBE Vector Stroke Dashes"); dashes.addProperty("ADBE Vector Stroke Dash 1").setValue(dash);
            routeStroke(layer).property("ADBE Vector Stroke Dashes").addProperty("ADBE Vector Stroke Gap 1").setValue(gap);
            dashes = routeStroke(layer).property("ADBE Vector Stroke Dashes");
