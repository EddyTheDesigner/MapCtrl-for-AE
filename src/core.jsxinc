                else if (props[i].numKeys > 0) { props[i].setValueAtTime(ctx.comp.time, c); } else { props[i].setValue(c); }
            }
            return props.length;
        });
    };
    C.addPin = function (mapPoint, label, options) {
        options = options || {};
        var ctx = context(), p = point(mapPoint), color = rgb(options.color, [1, 0.42, 0.29]), size = numeric(options.size, 18, 2, 150, "Pin size"), t;
        label = String(label || "").replace(/[\r\n]/g, " ").substr(0, 120);
        if (options.animate) { t = timing(ctx.comp, options.duration, 0, 1); }
        return undo("Add pin", function () {
            var layer = ctx.comp.layers.addShape(), id = uid(), r = size / 2, ellipse, textLayer, doc;
            layer.name = "Pin - " + (label || "Waypoint"); tag(layer, "pin", id); layer.label = 1; identity(layer, ctx.root, p); group(layer, "Pin");
            path(layer, "Pin", "Pin body", geometry(
