            if (flow !== 0) { routeStroke(layer).property("ADBE Vector Stroke Dashes").property("ADBE Vector Stroke Offset").expression = "-(time - " + ctx.comp.time + ") * " + flow + ";"; }
            contents(layer, "Route").addProperty("ADBE Vector Filter - Trim");
